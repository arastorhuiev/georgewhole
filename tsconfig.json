{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@lib/*": ["src/lib/*"],
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"],
      "@styles/*": ["src/styles/*"],
      "@i18n/*": ["src/i18n/*"],
      "@content/*": ["src/content/*"],
      "@quiz/*": ["src/quiz/*"],
      "@assets/*": ["src/assets/*"]
    }
  },
  "include": [".astro/types.d.ts", "src/**/*", "*.mjs", "*.ts"],
  "exclude": ["dist", "design-reference", "marketingskills", "devmarketing-skills", "research", ".omc"]
}
