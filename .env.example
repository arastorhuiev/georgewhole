# Production absolute-URL origin. Drives canonical / hreflang / sitemap / OG / robots / llms.
# No trailing slash. Local dev/preview can omit this (falls back to https://example.com).
SITE_URL=https://georgewhole.com

# Privacy-first analytics (Plausible). When set, the script loads on every page and
# `data-domain` is this value. Leave unset to ship zero analytics JS.
PUBLIC_PLAUSIBLE_DOMAIN=georgewhole.com
