---
import BaseLayout from '@layouts/BaseLayout.astro';
import BookDetailPage from '@/page-impl/BookDetailPage.astro';
import { booksFor, slugOf } from '@lib/content';

export async function getStaticPaths() {
  const entries = await booksFor('ru');
  return entries.map((entry) => ({
    params: { slug: slugOf(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const slug = slugOf(entry.id);
---

<BaseLayout
  locale="ru"
  path={`books/${slug}`}
  title={`${entry.data.title} · georgewhole`}
  description={entry.data.subtitle ?? entry.data.line}
>
  <BookDetailPage lang="ru" entry={entry} />
</BaseLayout>
