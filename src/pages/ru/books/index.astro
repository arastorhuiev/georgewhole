---
import BaseLayout from '@layouts/BaseLayout.astro';
import BooksIndexPage from '@/page-impl/BooksIndexPage.astro';
import { useTranslations } from '@i18n';

const lang = 'ru';
const t = useTranslations(lang);
---

<BaseLayout
  locale={lang}
  path="books"
  title={`${t.booksIndex.title} · ${t.brand}`}
  description={t.booksIndex.sub}
>
  <BooksIndexPage lang={lang} />
</BaseLayout>
