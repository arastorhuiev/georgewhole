---
import BaseLayout from '@layouts/BaseLayout.astro';
import AboutPage from '@/page-impl/AboutPage.astro';
import { useTranslations } from '@i18n';

const lang = 'ru';
const t = useTranslations(lang);
---

<BaseLayout
  locale={lang}
  path="about"
  title={`${t.about.kicker} · ${t.brand}`}
  description={t.about.sub}
>
  <AboutPage lang={lang} />
</BaseLayout>
