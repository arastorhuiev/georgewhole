---
import Nav from '@components/nav/Nav.astro';
import MobileNav from '@components/nav/MobileNav.astro';
import Kicker from '@components/common/Kicker.astro';
import AtmosImage from '@components/common/AtmosImage.astro';
import PullQuote from '@components/article/PullQuote.astro';
import NextSteps from '@components/common/NextSteps.astro';
import Footer from '@components/footer/Footer.astro';
import { getEntry } from 'astro:content';
import { useTranslations } from '@i18n';
import { buildLocaleSwitcherItems } from '@lib/locales';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang as any);
const locales = buildLocaleSwitcherItems(lang as any, 'about');

const navItems = [
  { key: 'articles',   label: t.nav.articles,   href: `/${lang}/articles`   },
  { key: 'books',      label: t.nav.books,       href: `/${lang}/books`      },
  { key: 'about',      label: t.nav.about,       href: `/${lang}/about`      },
  { key: 'newsletter', label: t.nav.newsletter,  href: `/${lang}/newsletter` },
];

const aboutEntry = await getEntry('about', lang as any);
const a = aboutEntry!.data;

// "Next steps" CTAs carry real destinations (label + locale-prefixed href).
const nextCtas: Array<[string, string]> = [
  [a.nextCtas[0], `/${lang}/quiz/`],
  [a.nextCtas[1], `/${lang}/articles/`],
  [a.nextCtas[2], `/${lang}/books/slozhnye/`],
];
---

  {/* Desktop nav — hidden on mobile */}
  <div class="hidden md:block">
    <Nav
      brand="georgewhole"
      brandHref={`/${lang}/`}
      brandTagline={t.brandTagline}
      items={navItems}
      active="about"
      locale={lang}
      locales={locales}
      wide
    />
  </div>
  {/* Mobile nav — hidden on desktop */}
  <div class="block md:hidden">
    <MobileNav
      brand="georgewhole"
      brandHref={`/${lang}/`}
      navItems={navItems}
      locales={locales}
      currentLocale={lang}
      labels={t.mobileNav}
    />
  </div>

  <main id="main">
    {/* ── Breadcrumb ── */}
    <nav
      class="flex items-center gap-[8px] px-[20px] py-[12px] md:px-[64px] md:py-[14px] font-mono text-[11px] tracking-[1px] uppercase text-ink-muted border-b border-[var(--color-hair)]"
      aria-label="Breadcrumb"
    >
      <a href={`/${lang}/`} class="text-ink-muted no-underline transition-colors hover:text-ink">{a.crumb[0]}</a>
      <span class="text-[var(--color-hair)]" aria-hidden="true">/</span>
      <span class="text-ink-soft" aria-current="page">{a.crumb[1]}</span>
    </nav>

    {/* ── Hero ── */}
    <section class="border-b border-[var(--color-hair)] px-[20px] pt-[36px] pb-[32px] grid grid-cols-1 gap-[22px] md:px-[64px] md:pt-[80px] md:pb-[64px] md:grid-cols-[1fr_1.2fr] md:gap-[72px] md:items-center">
      <div class="hero-text">
        <Kicker>{a.kicker}</Kicker>
        <h1 class="font-serif text-ink text-[32px] leading-[1.1] mt-[14px] mb-[16px] font-[400] tracking-[-0.5px] text-balance md:text-[54px] md:leading-[1.07] md:mt-[20px] md:mb-[24px] md:tracking-[-0.9px]">{a.title}</h1>
        <p class="font-serif text-ink-soft text-[17px] leading-[1.55] m-0 italic md:text-[20px] md:max-w-[540px]">{a.sub}</p>
      </div>
      <div class="hero-img">
        <AtmosImage height={460} label={t.atmos.aboutDusk} tone="dusk" accentTint />
      </div>
    </section>

    {/* ── Timeline + Narrative ── */}
    <section class="border-b border-[var(--color-hair)] px-[20px] py-[40px] grid grid-cols-1 gap-[32px] md:px-[64px] md:py-[88px] md:grid-cols-[220px_1fr] md:gap-[56px] md:items-start">
      <aside class="static md:sticky md:top-[32px]">
        <div class="font-mono text-ink-muted text-[10.5px] tracking-[1.4px] uppercase mb-[14px]">{a.timelineLabel}</div>
        {a.timeline.map(([year, text]) => (
          <div class="grid grid-cols-[52px_1fr] gap-[8px] py-[10px] border-t border-[var(--color-hair-soft)] text-[13px]">
            <span class="font-mono text-accent text-[13px] tracking-[0.4px]">{year}</span>
            <span class="font-sans text-ink-soft text-[13px] leading-[1.4]">{text}</span>
          </div>
        ))}
      </aside>

      <article class="font-serif text-ink text-[18px] leading-[1.7] md:max-w-[70ch] md:text-[20px] md:justify-self-center">
        <h2 class="font-serif text-ink text-[24px] leading-[1.25] font-[400] tracking-[-0.3px] mt-[32px] mb-[16px] first:mt-0 md:text-[32px] md:leading-[1.2] md:tracking-[-0.4px] md:mt-[40px] md:mb-[24px]">{a.h2_1}</h2>
        <p class="mb-[20px] md:mb-[24px]">{a.p1}</p>
        <p class="mb-[20px] md:mb-[24px]">{a.p2}</p>

        <PullQuote attribution={a.pullBy}>{a.pull}</PullQuote>

        <h2 class="font-serif text-ink text-[24px] leading-[1.25] font-[400] tracking-[-0.3px] mt-[32px] mb-[16px] first:mt-0 md:text-[32px] md:leading-[1.2] md:tracking-[-0.4px] md:mt-[40px] md:mb-[24px]">{a.h2_2}</h2>
        <p class="mb-[20px] md:mb-[24px]">{a.p3}</p>
        <p class="mb-[20px] md:mb-[24px]">{a.p4}</p>

        <h2 class="font-serif text-ink text-[24px] leading-[1.25] font-[400] tracking-[-0.3px] mt-[32px] mb-[16px] first:mt-0 md:text-[32px] md:leading-[1.2] md:tracking-[-0.4px] md:mt-[40px] md:mb-[24px]">{a.h2_3}</h2>
        <p class="mb-[12px]">{a.p5}</p>
        <ul class="font-sans text-ink-soft mt-[20px] mb-[24px] p-0 list-none text-[15.5px] leading-[1.6] md:text-[17.5px] md:leading-[1.65]" role="list">
          {a.nots.map((item) => (
            <li class="py-[7px] border-t border-[var(--color-hair-soft)] flex gap-[10px] md:py-[8px] md:gap-[12px]">
              <span class="font-mono text-accent shrink-0" aria-hidden="true">—</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </article>
    </section>

    {/* ── Credibility trio ── */}
    <section class="border-b border-[var(--color-hair)] px-[20px] py-[36px] bg-[var(--color-surface-soft)] md:px-[64px] md:py-[80px]">
      <div class="grid grid-cols-1 gap-[24px] md:grid-cols-[1fr_1.4fr] md:gap-[56px] md:items-start">
        <div class="cred-intro">
          <Kicker>{a.credKicker}</Kicker>
          <h2 class="font-serif text-ink text-[22px] leading-[1.3] font-[400] tracking-[-0.2px] mt-[12px] mb-[18px] md:text-[32px] md:leading-[1.2] md:tracking-[-0.4px] md:mt-[14px] md:mb-[20px]">{a.credTitle}</h2>
          <p class="font-sans text-ink-soft text-[14px] leading-[1.7] m-0 md:text-[15.5px]">{a.credBody}</p>
        </div>
        <div class="flex flex-col gap-[12px] md:grid md:grid-cols-[repeat(2,1fr)] md:gap-[20px]">
          {a.credCards.map(([kicker, title, body]) => (
            <div class="bg-bg p-[18px] border border-[var(--color-hair)] font-sans md:p-[22px]">
              <Kicker>{kicker}</Kicker>
              <h3 class="font-serif text-ink text-[17px] mt-[8px] mb-[6px] leading-[1.3] font-[400] tracking-[-0.2px] md:text-[19px] md:mt-[10px] md:mb-[8px]">{title}</h3>
              <p class="font-sans text-ink-soft text-[13px] leading-[1.55] m-0 md:text-[13.5px] md:leading-[1.6]">{body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── Next steps ── */}
    <section class="px-[20px] py-[40px] md:px-[64px] md:py-[88px]">
      <div class="hidden md:block">
        <NextSteps
          kicker={a.nextKicker}
          title={a.nextTitle}
          sub={a.nextSub}
          ctas={nextCtas}
          layout="desktop"
        />
      </div>
      <div class="block md:hidden">
        <NextSteps
          kicker={a.nextKicker}
          title={a.nextTitle}
          sub={a.nextSub}
          ctas={nextCtas}
          layout="mobile"
        />
      </div>
    </section>
  </main>

  <div class="hidden md:block">
    <Footer strings={t.footer} locale={lang} locales={locales} layout="desktop" />
  </div>
  <div class="block md:hidden">
    <Footer strings={t.footer} locale={lang} locales={locales} layout="mobile" />
  </div>
