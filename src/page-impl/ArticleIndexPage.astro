---
import Nav from '@components/nav/Nav.astro';
import MobileNav from '@components/nav/MobileNav.astro';
import AtmosImage from '@components/common/AtmosImage.astro';
import Kicker from '@components/common/Kicker.astro';
import EmailCapture from '@components/forms/EmailCapture.astro';
import Footer from '@components/footer/Footer.astro';
import Button from '@components/common/Button.astro';
import { useTranslations } from '@i18n/index';
import { articlesFor, slugOf } from '@lib/content';
import { buildLocaleSwitcherItems } from '@lib/locales';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang as any);
const locales = buildLocaleSwitcherItems(lang as any, 'articles');

const navItems = [
  { key: 'articles',   label: t.nav.articles,   href: `/${lang}/articles`   },
  { key: 'books',      label: t.nav.books,      href: `/${lang}/books`      },
  { key: 'about',      label: t.nav.about,      href: `/${lang}/about`      },
  { key: 'newsletter', label: t.nav.newsletter, href: `/${lang}/newsletter` },
];

const allArticles = await articlesFor(lang as any);
const featured = allArticles[0];
const rest = allArticles.slice(1);

// Group rest into a simple "all" series — the design shows series; at this
// stage content may not have series metadata so we render a single flat group.
// When series metadata is added to frontmatter this can be refined.
const series = [
  {
    label: t.articlesIndex.seriesLabel,
    note: t.articlesIndex.count,
    items: rest,
  },
];
---

  <!-- Desktop nav -->
  <div class="block max-md:hidden">
    <Nav
      brand="georgewhole"
      brandHref={`/${lang}/`}
      brandTagline={t.brandTagline}
      items={navItems}
      active="articles"
      locale={lang}
      locales={locales}
      wide
    />
  </div>
  <!-- Mobile nav -->
  <div class="hidden max-md:block">
    <MobileNav
      brand="georgewhole"
      brandHref={`/${lang}/`}
      navItems={navItems}
      locales={locales}
      currentLocale={lang}
      labels={t.mobileNav}
    />
  </div>

  <main id="main">
  <!-- Page header -->
  <header class="px-5 pt-7 pb-8 border-b border-[var(--color-hair)] md:px-16 md:pt-10 md:pb-12">
    <!-- Breadcrumb -->
    <nav
      class="font-mono text-[10px] tracking-[1.2px] uppercase text-ink-muted mb-[18px] flex items-center gap-[10px] flex-wrap md:text-[11px] md:mb-7"
      aria-label="Breadcrumb"
    >
      <a href={`/${lang}/`} class="text-ink-muted no-underline hover:text-ink">{t.common.breadcrumbHome}</a>
      <span class="opacity-40" aria-hidden="true">/</span>
      <span class="text-ink">{t.nav.articles}</span>
    </nav>

    <div class="max-w-[820px]">
      <Kicker>{t.articlesIndex.kicker}</Kicker>
      <h1 class="font-serif text-[32px] leading-[1.06] mt-3 mb-[14px] font-normal text-ink tracking-[-0.5px] text-balance md:text-[52px] md:tracking-[-0.9px] md:mt-4 md:mb-[18px]">{t.articlesIndex.title}</h1>
      <p class="font-serif text-[17px] leading-[1.5] text-ink-soft m-0 italic max-w-[680px] md:text-[20px]">{t.articlesIndex.sub}</p>
      <div class="font-mono text-[11px] tracking-[0.6px] text-ink-muted mt-[18px] uppercase">{t.articlesIndex.count}</div>
    </div>
  </header>

  <!-- Featured article -->
  {featured && (
    <section class="px-5 py-7 border-b border-[var(--color-hair)] md:px-16 md:py-14">
      <a href={`/${lang}/articles/${slugOf(featured.id)}/`} class="no-underline text-inherit block group">
        <div class="grid grid-cols-1 gap-4 items-center md:grid-cols-[1.1fr_1fr] md:gap-12">
          <AtmosImage
            height={340}
            label={featured.data.image ?? 'featured'}
            tone={featured.data.imageTone ?? 'morning'}
          />
          <div class="flex flex-col gap-3">
            {featured.data.kicker && <Kicker>{featured.data.kicker}</Kicker>}
            <h2 class="font-serif text-[26px] leading-[1.2] tracking-[-0.3px] font-normal text-ink m-0 text-balance transition-colors duration-[0.18s] ease-[ease] group-hover:text-accent md:text-[38px] md:leading-[1.12] md:tracking-[-0.5px]">{featured.data.title}</h2>
            <p class="font-sans text-[14px] leading-[1.55] text-ink-soft m-0 max-w-[480px] md:text-[15.5px] md:leading-[1.6]">{featured.data.summary}</p>
            <div class="flex items-center gap-4 font-mono text-[11px] text-ink-muted tracking-[0.6px] uppercase">
              {featured.data.readingTime && <span>{featured.data.readingTime}</span>}
              <span class="text-accent" aria-hidden="true">→</span>
            </div>
          </div>
        </div>
      </a>
    </section>
  )}

  {/* Topic filtering is deferred until articles carry tag metadata — a
      non-functional filter row was removed rather than ship a dead control.
      See docs/QUESTIONS.md. */}

  <!-- Article series / list -->
  <section class="px-5 pt-3 pb-12 md:px-16 md:pt-6 md:pb-[72px]">
    {series.map((s, si) => (
      <div class:list={[
        'mt-7 md:mt-10',
        si > 0 && 'mt-10 md:mt-16',
      ]}>
        <div class="flex items-baseline justify-between mb-[6px] flex-wrap gap-3">
          <h3 class="font-serif text-[22px] font-normal text-ink tracking-[-0.3px] m-0 md:text-[26px]">{s.label}</h3>
          {s.note && <span class="font-serif italic text-[14px] text-ink-muted md:text-[15px]">{s.note}</span>}
        </div>
        <div class="mt-1">
          {s.items.map((article, idx) => (
            <a
              href={`/${lang}/articles/${slugOf(article.id)}/`}
              class="block py-[18px] border-t border-[var(--color-hair-soft)] no-underline text-inherit hover:[&_.row-title]:text-accent md:grid md:grid-cols-[56px_1fr_96px_20px] md:gap-5 md:items-baseline md:py-[22px] md:border-[var(--color-hair)]"
            >
              <span class="font-mono text-[11px] text-accent tracking-[0.4px] inline-block mb-1 md:text-[12px] md:inline md:mb-0">
                {String(idx + 2).padStart(2, '0')}
              </span>
              <div class="row-body">
                <h4 class="row-title font-serif text-[20px] font-normal text-ink m-0 mb-[5px] leading-[1.3] tracking-[-0.2px] transition-colors duration-[0.18s] ease-[ease] md:text-[23px] md:leading-[1.25] md:mb-[6px]">{article.data.title}</h4>
                <p class="font-sans text-[13.5px] text-ink-soft leading-[1.55] m-0 max-w-[560px] md:text-[14px]">{article.data.summary}</p>
              </div>
              <span class="font-mono text-[10.5px] text-ink-muted tracking-[0.6px] float-right inline-block md:float-none md:inline md:text-[11px] md:text-right">{article.data.readingTime ?? ''}</span>
              <span class="text-accent hidden md:inline-flex md:self-center" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>

  <!-- Books cross-promo -->
  <section class="px-5 py-10 border-t border-[var(--color-hair)] border-b bg-surface-soft md:px-16 md:py-16">
    <div class="max-w-[640px] flex flex-col gap-[14px]">
      <Kicker>{t.booksPromo.kicker}</Kicker>
      <h2 class="font-serif text-[26px] font-normal text-ink tracking-[-0.5px] leading-[1.15] m-0 text-balance md:text-[36px]">{t.booksPromo.title}</h2>
      <p class="font-serif text-[16px] leading-[1.55] text-ink-soft m-0 italic md:text-[18px]">{t.booksPromo.sub}</p>
      <Button variant="primary" href={`/${lang}/books/`}>{t.booksPromo.cta}</Button>
    </div>
  </section>

  <!-- Newsletter capture -->
  <section class="px-5 py-9 border-b border-[var(--color-hair)] md:px-16 md:py-16">
    <EmailCapture
      variant="newsletter"
      strings={t.newsletter}
    />
  </section>
  </main>

  <Footer
    layout="desktop"
    strings={t.footer}
    locale={lang}
    locales={locales}
  />
