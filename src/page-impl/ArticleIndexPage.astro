---
import Nav from '@components/nav/Nav.astro';
import MobileNav from '@components/nav/MobileNav.astro';
import AtmosImage from '@components/common/AtmosImage.astro';
import Kicker from '@components/common/Kicker.astro';
import EmailCapture from '@components/forms/EmailCapture.astro';
import Footer from '@components/footer/Footer.astro';
import Button from '@components/common/Button.astro';
import { useTranslations } from '@i18n/index';
import { articlesFor, slugOf } from '@lib/content';
import { buildLocaleSwitcherItems } from '@lib/locales';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang as any);
const locales = buildLocaleSwitcherItems(lang as any, 'articles');

const navItems = [
  { key: 'articles',   label: t.nav.articles,   href: `/${lang}/articles`   },
  { key: 'books',      label: t.nav.books,      href: `/${lang}/books`      },
  { key: 'about',      label: t.nav.about,      href: `/${lang}/about`      },
  { key: 'newsletter', label: t.nav.newsletter, href: `/${lang}/newsletter` },
];

const allArticles = await articlesFor(lang as any);
const featured = allArticles[0];
const rest = allArticles.slice(1);

// Group rest into a simple "all" series — the design shows series; at this
// stage content may not have series metadata so we render a single flat group.
// When series metadata is added to frontmatter this can be refined.
const series = [
  {
    label: t.articlesIndex.seriesLabel ?? 'Все статьи',
    note: t.articlesIndex.count,
    items: rest,
  },
];
---

  <!-- Desktop nav -->
  <div class="hidden-mobile">
    <Nav
      brand="georgewhole"
      brandHref={`/${lang}/`}
      brandTagline={t.brandTagline}
      items={navItems}
      active="articles"
      locale={lang}
      locales={locales}
      wide
    />
  </div>
  <!-- Mobile nav -->
  <div class="hidden-desktop">
    <MobileNav
      brand="georgewhole"
      brandHref={`/${lang}/`}
      navItems={navItems}
      locales={locales}
      currentLocale={lang}
      labels={t.mobileNav}
    />
  </div>

  <!-- Page header -->
  <header class="page-header">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={`/${lang}/`} class="crumb-link">Главная</a>
      <span class="crumb-sep" aria-hidden="true">/</span>
      <span class="crumb-current">{t.nav.articles}</span>
    </nav>

    <div class="header-inner">
      <Kicker>{t.articlesIndex.kicker}</Kicker>
      <h1 class="page-title">{t.articlesIndex.title}</h1>
      <p class="page-sub">{t.articlesIndex.sub}</p>
      <div class="page-count">{t.articlesIndex.count}</div>
    </div>
  </header>

  <!-- Featured article -->
  {featured && (
    <section class="featured-section">
      <a href={`/${lang}/articles/${slugOf(featured.id)}/`} class="featured-link">
        <div class="featured-grid">
          <AtmosImage
            height={340}
            label={featured.data.image ?? 'featured'}
            tone={featured.data.imageTone ?? 'morning'}
          />
          <div class="featured-body">
            {featured.data.kicker && <Kicker>{featured.data.kicker}</Kicker>}
            <h2 class="featured-title">{featured.data.title}</h2>
            <p class="featured-summary">{featured.data.summary}</p>
            <div class="featured-meta">
              {featured.data.readingTime && <span>{featured.data.readingTime}</span>}
              <span class="feat-arrow" aria-hidden="true">→</span>
            </div>
          </div>
        </div>
      </a>
    </section>
  )}

  <!-- Filter tags -->
  <section class="tags-section" aria-label="Фильтр по темам">
    <div class="tags-row">
      {t.reading.tags.map((tag, i) => (
        <span
          class:list={['tagchip', i === 0 && 'tagchip--active']}
        >
          {tag}
        </span>
      ))}
    </div>
  </section>

  <!-- Article series / list -->
  <section class="series-section">
    {series.map((s, si) => (
      <div class:list={['series-group', si > 0 && 'series-group--gap']}>
        <div class="series-head">
          <h3 class="series-label">{s.label}</h3>
          {s.note && <span class="series-note">{s.note}</span>}
        </div>
        <div class="article-list">
          {s.items.map((article, idx) => (
            <a
              href={`/${lang}/articles/${slugOf(article.id)}/`}
              class="article-row"
            >
              <span class="row-no">
                {String(idx + 2).padStart(2, '0')}
              </span>
              <div class="row-body">
                <h4 class="row-title">{article.data.title}</h4>
                <p class="row-summary">{article.data.summary}</p>
              </div>
              <span class="row-time">{article.data.readingTime ?? ''}</span>
              <span class="row-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>

  <!-- Books cross-promo -->
  <section class="books-promo">
    <div class="promo-inner">
      <Kicker>{t.booksPromo.kicker}</Kicker>
      <h2 class="promo-title">{t.booksPromo.title}</h2>
      <p class="promo-sub">{t.booksPromo.sub}</p>
      <Button variant="primary" href={`/${lang}/books/`}>{t.booksPromo.cta}</Button>
    </div>
  </section>

  <!-- Newsletter capture -->
  <section class="newsletter-section">
    <EmailCapture
      variant="newsletter"
      strings={t.newsletter}
    />
  </section>

  <Footer
    layout="desktop"
    strings={t.footer}
    locale={lang}
    locales={locales}
  />

<style>
  /* ── Visibility toggles ── */
  .hidden-mobile { display: block; }
  .hidden-desktop { display: none; }

  @media (max-width: 767px) {
    .hidden-mobile { display: none; }
    .hidden-desktop { display: block; }
  }

  /* ── Page header ── */
  .page-header {
    padding: 40px 64px 48px;
    border-bottom: 1px solid var(--color-hair);
  }

  @media (max-width: 767px) {
    .page-header {
      padding: 28px 20px 32px;
    }
  }

  .breadcrumb {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin-bottom: 28px;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  @media (max-width: 767px) {
    .breadcrumb {
      font-size: 10px;
      margin-bottom: 18px;
    }
  }

  .crumb-link {
    color: var(--color-ink-muted);
    text-decoration: none;
  }
  .crumb-link:hover { color: var(--color-ink); }
  .crumb-sep { opacity: 0.4; }
  .crumb-current { color: var(--color-ink); }

  .header-inner {
    max-width: 820px;
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: 52px;
    line-height: 1.06;
    margin: 16px 0 18px;
    font-weight: 400;
    color: var(--color-ink);
    letter-spacing: -0.9px;
    text-wrap: balance;
  }

  @media (max-width: 767px) {
    .page-title {
      font-size: 32px;
      line-height: 1.06;
      letter-spacing: -0.5px;
      margin: 12px 0 14px;
    }
  }

  .page-sub {
    font-family: var(--font-serif);
    font-size: 20px;
    line-height: 1.5;
    color: var(--color-ink-soft);
    margin: 0;
    font-style: italic;
    max-width: 680px;
  }

  @media (max-width: 767px) {
    .page-sub {
      font-size: 17px;
    }
  }

  .page-count {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.6px;
    color: var(--color-ink-muted);
    margin-top: 18px;
    text-transform: uppercase;
  }

  /* ── Featured ── */
  .featured-section {
    padding: 56px 64px;
    border-bottom: 1px solid var(--color-hair);
  }

  @media (max-width: 767px) {
    .featured-section {
      padding: 28px 20px;
    }
  }

  .featured-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 48px;
    align-items: center;
  }

  @media (max-width: 767px) {
    .featured-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }

  .featured-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .featured-title {
    font-family: var(--font-serif);
    font-size: 38px;
    line-height: 1.12;
    font-weight: 400;
    color: var(--color-ink);
    letter-spacing: -0.5px;
    margin: 0;
    text-wrap: balance;
  }

  @media (max-width: 767px) {
    .featured-title {
      font-size: 26px;
      line-height: 1.2;
      letter-spacing: -0.3px;
    }
  }

  .featured-link:hover .featured-title {
    color: var(--color-accent);
  }

  .featured-summary {
    font-family: var(--font-sans);
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--color-ink-soft);
    margin: 0;
    max-width: 480px;
  }

  @media (max-width: 767px) {
    .featured-summary {
      font-size: 14px;
      line-height: 1.55;
    }
  }

  .featured-meta {
    display: flex;
    align-items: center;
    gap: 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-ink-muted);
    letter-spacing: 0.6px;
    text-transform: uppercase;
  }

  .feat-arrow {
    color: var(--color-accent);
  }

  /* ── Tags ── */
  .tags-section {
    padding: 28px 64px;
    border-bottom: 1px solid var(--color-hair);
  }

  @media (max-width: 767px) {
    .tags-section {
      padding: 20px 20px;
    }
  }

  .tags-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .tagchip {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    padding: 8px 15px;
    border-radius: var(--radius-pill, 999px);
    cursor: pointer;
    border: 1px solid var(--color-hair);
    background: transparent;
    color: var(--color-ink-soft);
  }

  @media (max-width: 767px) {
    .tagchip {
      font-size: 11px;
      padding: 7px 13px;
      letter-spacing: 0.6px;
    }
  }

  .tagchip:hover {
    border-color: var(--color-accent) !important;
    color: var(--color-ink) !important;
  }

  .tagchip--active {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-accent-fg, #fff);
  }

  /* ── Series / list ── */
  .series-section {
    padding: 24px 64px 72px;
  }

  @media (max-width: 767px) {
    .series-section {
      padding: 12px 20px 48px;
    }
  }

  .series-group {
    margin-top: 40px;
  }

  .series-group--gap {
    margin-top: 64px;
  }

  @media (max-width: 767px) {
    .series-group { margin-top: 28px; }
    .series-group--gap { margin-top: 40px; }
  }

  .series-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 6px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .series-label {
    font-family: var(--font-serif);
    font-size: 26px;
    font-weight: 400;
    color: var(--color-ink);
    letter-spacing: -0.3px;
    margin: 0;
  }

  @media (max-width: 767px) {
    .series-label {
      font-size: 22px;
    }
  }

  .series-note {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 15px;
    color: var(--color-ink-muted);
  }

  @media (max-width: 767px) {
    .series-note {
      font-size: 14px;
    }
  }

  /* ── Article list rows ── */
  .article-list {
    margin-top: 4px;
  }

  .article-row {
    display: grid;
    grid-template-columns: 56px 1fr 96px 20px;
    gap: 20px;
    align-items: baseline;
    padding: 22px 0;
    border-top: 1px solid var(--color-hair);
    text-decoration: none;
    color: inherit;
  }

  @media (max-width: 767px) {
    .article-row {
      display: block;
      padding: 18px 0;
      border-top: 1px solid var(--color-hair-soft);
    }
  }

  .article-row:hover .row-title {
    color: var(--color-accent);
  }

  .row-no {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-accent);
    letter-spacing: 0.4px;
  }

  @media (max-width: 767px) {
    .row-no {
      font-size: 11px;
      display: inline-block;
      margin-bottom: 4px;
    }
  }

  .row-body {
    /* naturally takes 1fr on desktop */
  }

  .row-title {
    font-family: var(--font-serif);
    font-size: 23px;
    font-weight: 400;
    color: var(--color-ink);
    margin: 0 0 6px;
    line-height: 1.25;
    letter-spacing: -0.2px;
  }

  @media (max-width: 767px) {
    .row-title {
      font-size: 20px;
      line-height: 1.3;
      margin: 0 0 5px;
    }
  }

  .row-summary {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-ink-soft);
    line-height: 1.55;
    margin: 0;
    max-width: 560px;
  }

  @media (max-width: 767px) {
    .row-summary {
      font-size: 13.5px;
    }
  }

  .row-time {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-ink-muted);
    letter-spacing: 0.6px;
    text-align: right;
  }

  @media (max-width: 767px) {
    .row-time {
      display: inline-block;
      float: right;
      font-size: 10.5px;
      letter-spacing: 0.6px;
    }
  }

  .row-arrow {
    color: var(--color-accent);
    display: inline-flex;
    align-self: center;
  }

  @media (max-width: 767px) {
    .row-arrow { display: none; }
  }

  /* ── Books promo ── */
  .books-promo {
    padding: 64px 64px;
    border-top: 1px solid var(--color-hair);
    border-bottom: 1px solid var(--color-hair);
    background: var(--color-surface-soft);
  }

  @media (max-width: 767px) {
    .books-promo {
      padding: 40px 20px;
    }
  }

  .promo-inner {
    max-width: 640px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .promo-title {
    font-family: var(--font-serif);
    font-size: 36px;
    font-weight: 400;
    color: var(--color-ink);
    letter-spacing: -0.5px;
    line-height: 1.15;
    margin: 0;
    text-wrap: balance;
  }

  @media (max-width: 767px) {
    .promo-title {
      font-size: 26px;
    }
  }

  .promo-sub {
    font-family: var(--font-serif);
    font-size: 18px;
    line-height: 1.55;
    color: var(--color-ink-soft);
    margin: 0;
    font-style: italic;
  }

  @media (max-width: 767px) {
    .promo-sub {
      font-size: 16px;
    }
  }

  /* ── Newsletter ── */
  .newsletter-section {
    padding: 64px 64px;
    border-bottom: 1px solid var(--color-hair);
  }

  @media (max-width: 767px) {
    .newsletter-section {
      padding: 36px 20px;
    }
  }
</style>
