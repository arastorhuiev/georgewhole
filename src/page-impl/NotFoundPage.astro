---
import { useTranslations } from '@i18n/index';
import { buildLocaleSwitcherItems } from '@lib/locales';

import Nav from '@components/nav/Nav.astro';
import MobileNav from '@components/nav/MobileNav.astro';
import Footer from '@components/footer/Footer.astro';
import Button from '@components/common/Button.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang as any);

const locales = buildLocaleSwitcherItems(lang as any, '');

const navItems = [
  { key: 'articles',   label: t.nav.articles,   href: `/${lang}/articles`   },
  { key: 'books',      label: t.nav.books,      href: `/${lang}/books`      },
  { key: 'about',      label: t.nav.about,      href: `/${lang}/about`      },
  { key: 'newsletter', label: t.nav.newsletter, href: `/${lang}/newsletter` },
];
---

<div style="background:var(--color-bg);min-height:100%;box-sizing:border-box;">

  <!-- ── NAV ─────────────────────────────────────────────────── -->
  <div class="hidden md:block">
    <Nav
      brand="georgewhole"
      brandHref={`/${lang}/`}
      brandTagline={t.brandTagline}
      items={navItems}
      active=""
      locale={lang}
      locales={locales}
      wide
    />
  </div>
  <div class="md:hidden">
    <MobileNav
      brand="georgewhole"
      brandHref={`/${lang}/`}
      navItems={navItems}
      locales={locales}
      currentLocale={lang}
      labels={t.mobileNav}
    />
  </div>

  <!-- ── 404 CONTENT ───────────────────────────────────────────── -->
  <section
    class="notfound-section"
    style="border-bottom:1px solid var(--color-hair);"
  >
    <!-- Typographic 404 mark -->
    <div style="position:relative;margin-bottom:28px;">
      <div
        class="notfound-code font-serif text-ink"
        style="line-height:1;letter-spacing:-4px;font-weight:400;"
      >
        {t.notFound.code}
      </div>
      <!-- accent underline rule -->
      <div
        class="notfound-rule"
        style="position:absolute;left:50%;transform:translateX(-50%);height:2px;background:var(--color-accent);"
        aria-hidden="true"
      />
    </div>

    <h1
      class="font-serif text-ink"
      style="font-size:clamp(28px,4vw,38px);font-weight:400;letter-spacing:-0.4px;margin:0 0 14px;"
    >
      {t.notFound.title}
    </h1>

    <p
      class="font-serif text-ink-soft"
      style="font-style:italic;font-size:clamp(16px,1.8vw,19px);line-height:1.55;margin:0 0 32px;max-width:420px;"
    >
      {t.notFound.sub}
    </p>

    <!-- CTAs: primary home + 2 ghost -->
    <div class="notfound-ctas">
      <Button variant="primary" href={`/${lang}/`}>
        {t.notFound.ctas[0]}
      </Button>
      <Button variant="ghost" href={`/${lang}/articles/`}>
        {t.notFound.ctas[1]}
      </Button>
      <Button variant="ghost" href={`/${lang}/quiz/`}>
        {t.notFound.ctas[2]}
      </Button>
    </div>
  </section>

  <!-- ── FOOTER ─────────────────────────────────────────────────── -->
  <div class="hidden md:block">
    <Footer strings={t.footer} locale={lang} locales={locales} />
  </div>
  <div class="md:hidden">
    <Footer strings={t.footer} locale={lang} locales={locales} layout="mobile" />
  </div>

</div>

<style>
  /* ── 404 section ── */
  .notfound-section {
    padding: 72px 24px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  @media (min-width: 768px) {
    .notfound-section {
      padding: 120px 64px;
    }
  }

  /* Giant 404 numeral */
  .notfound-code {
    font-size: 92px;
  }

  @media (min-width: 768px) {
    .notfound-code {
      font-size: 140px;
    }
  }

  /* Accent rule under the numeral */
  .notfound-rule {
    width: 48px;
    bottom: -2px;
  }

  @media (min-width: 768px) {
    .notfound-rule {
      width: 64px;
      bottom: -6px;
    }
  }

  /* CTA row: column on mobile, row on desktop */
  .notfound-ctas {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .notfound-ctas {
      flex-direction: row;
    }
  }
</style>
