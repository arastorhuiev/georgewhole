---
// ShelfStatus.astro — status pill: out → accent filled dot; soon → muted hollow dot.
// Ported from design-reference/project/books-ru.jsx → ShelfStatus.

interface Props {
  status: 'out' | 'soon';
  label: string;
  withDot?: boolean;
}

const { status, label, withDot = true } = Astro.props;
const out = status === 'out';
---

<span
  class:list={['font-mono', out ? 'text-accent' : 'text-ink-muted']}
  style="display:inline-flex;align-items:center;gap:6px;font-size:10.5px;letter-spacing:1px;text-transform:uppercase;"
>
  {withDot && (
    <span
      style={out
        ? 'width:6px;height:6px;border-radius:3px;background:var(--color-accent);flex-shrink:0;'
        : 'width:6px;height:6px;border-radius:3px;background:transparent;border:1px solid var(--color-ink-muted);flex-shrink:0;'}
    />
  )}
  {label}
</span>
