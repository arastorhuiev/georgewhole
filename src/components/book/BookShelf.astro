---
// BookShelf.astro — 5-col desktop grid / stacked mobile rows of book covers.
// Ported pixel-perfect from design-reference/project/books-ru.jsx → BookShelfRU.

import BookCover from '@components/book/BookCover.astro';
import ShelfStatus from '@components/book/ShelfStatus.astro';
import ShelfThemes from '@components/book/ShelfThemes.astro';
import Kicker from '@components/common/Kicker.astro';
import Button from '@components/common/Button.astro';

interface BookItem {
  id: string;
  href?: string;
  num: string;
  title: string;
  themes: string[];
  status: 'out' | 'soon';
  cover: {
    bg: string;
    fg: string;
    rule: string;
    tagline: string;
  };
}

interface Props {
  books: BookItem[];
  labels: {
    statusOut: string;
    statusSoon: string;
  };
  layout?: 'desktop' | 'mobile';
  heading?: {
    kicker: string;
    title: string;
    sub: string;
    all: string;
    allHref?: string;
  };
}

const { books, labels, layout = 'desktop', heading } = Astro.props;
const wide = layout === 'desktop';
---

<section
  class:list={[
    'border-b border-hair',
    wide ? 'px-16 py-[88px]' : 'px-5 py-12',
  ]}
>
  {heading && (
    <div
      class:list={[
        'flex items-end justify-between gap-6 flex-wrap',
        wide ? 'mb-[52px]' : 'mb-7',
      ]}
    >
      <div class:list={[wide ? 'max-w-[660px]' : 'max-w-full']}>
        <Kicker>{heading.kicker}</Kicker>
        <h2
          class:list={[
            'font-serif text-ink font-normal tracking-[-0.5px] mt-[14px] mb-3',
            wide ? 'text-[40px] leading-[1.12]' : 'text-[28px] leading-[1.12]',
          ]}
        >
          {heading.title}
        </h2>
        <p
          class:list={[
            'font-serif text-ink-soft italic leading-[1.55] m-0',
            wide ? 'text-[18px]' : 'text-[15.5px]',
          ]}
        >
          {heading.sub}
        </p>
      </div>
      <Button variant="text" href={heading.allHref ?? '#'}>{heading.all}</Button>
    </div>
  )}

  {wide ? (
    <div class="grid grid-cols-5 gap-6 items-start">
      {books.map((b) => (
        <a
          href={b.href ?? `#${b.id}`}
          class:list={[
            'group cursor-pointer flex flex-col no-underline',
          ]}
        >
          {/* cover zone — fixed height so every spine sits on one shelf line */}
          <div
            class:list={[
              'h-[224px] flex items-end justify-center',
              b.status === 'out'
                ? 'border-b-2 border-accent'
                : 'border-b border-hair',
            ]}
          >
            <BookCover
              title={b.title}
              num={b.num}
              w={148}
              h={210}
              bg={b.cover.bg}
              fg={b.cover.fg}
              rule={b.cover.rule}
              tagline={b.cover.tagline}
              class="group-hover:-translate-y-[5px] group-hover:rotate-[-0.6deg] group-hover:shadow-[6px_12px_0_rgba(42,39,35,0.1),0_6px_18px_rgba(0,0,0,0.2)]"
            />
          </div>
          <div class="mt-4">
            <ShelfStatus
              status={b.status}
              label={b.status === 'out' ? labels.statusOut : labels.statusSoon}
            />
            <h3
              class="bookcard-t font-serif text-ink font-normal text-[18px] leading-[1.22] tracking-[-0.3px] mt-[10px] mb-2 text-wrap-pretty transition-colors group-hover:text-accent"
            >
              {b.title}
            </h3>
            <ShelfThemes themes={b.themes} />
          </div>
        </a>
      ))}
    </div>
  ) : (
    <div class="flex flex-col">
      {books.map((b) => (
        <a
          href={b.href ?? `#${b.id}`}
          class:list={[
            'group cursor-pointer grid grid-cols-[72px_1fr] gap-[18px] items-center py-5',
            'border-t border-hair-soft no-underline',
          ]}
        >
          <div class="flex justify-center">
            <BookCover
              title={b.title}
              num={b.num}
              w={72}
              h={104}
              bg={b.cover.bg}
              fg={b.cover.fg}
              rule={b.cover.rule}
              tagline={b.cover.tagline}
              class="group-hover:-translate-y-[5px] group-hover:rotate-[-0.6deg] group-hover:shadow-[6px_12px_0_rgba(42,39,35,0.1),0_6px_18px_rgba(0,0,0,0.2)]"
            />
          </div>
          <div>
            <ShelfStatus
              status={b.status}
              label={b.status === 'out' ? labels.statusOut : labels.statusSoon}
            />
            <h3
              class="bookcard-t font-serif text-ink font-normal text-[19px] leading-[1.2] tracking-[-0.2px] mt-2 mb-[7px] text-wrap-pretty transition-colors group-hover:text-accent"
            >
              {b.title}
            </h3>
            <ShelfThemes themes={b.themes} size={10} />
          </div>
        </a>
      ))}
      {heading && (
        <div class="mt-5">
          <Button variant="text" href={heading.allHref ?? '#'}>{heading.all}</Button>
        </div>
      )}
    </div>
  )}
</section>
