---
// RetailerLinks.astro — highlighted store links with accent-hair border.
// Ported from docs/design/project/blocks-ru.jsx → RetailerLinksRU.

import Icon from '@components/common/Icon.astro';

// Each item is [name, note, href?]. When a real store URL is present the chip is
// a working external link; until then it renders as a non-clickable info chip
// (never a dead href="#"). Owner drops in real retailer URLs later.
interface Props {
  items: Array<[string, string, string?]>;
  status?: string;
  label?: string;
}

const { items, status, label } = Astro.props;
---

<div>
  {label && (
    <div class="font-mono text-ink-muted text-[10.5px] tracking-[1.4px] uppercase mb-3">
      {label}
    </div>
  )}
  <div class="flex gap-[10px] flex-wrap items-center">
    {items.map(([name, note, href]) => (
      href ? (
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          class="retailer font-sans text-ink bg-bg inline-flex items-center gap-2 px-[14px] py-[9px] border border-accent rounded-md no-underline hover:bg-[rgba(63,107,94,0.06)] hover:-translate-y-px hover:shadow-[0_2px_7px_rgba(42,39,35,0.08)]"
        >
          <span class="text-[13.5px] font-semibold">{name}</span>
          {note && <span class="font-mono text-ink-muted text-[11.5px] tracking-[0.3px]">{note}</span>}
          <span class="text-accent inline-flex"><Icon name="extArrow" size={11} /></span>
        </a>
      ) : (
        <span class="retailer-static font-sans text-ink bg-bg inline-flex items-center gap-2 px-[14px] py-[9px] border border-accent-hair rounded-md">
          <span class="text-[13.5px] font-semibold">{name}</span>
          {note && <span class="font-mono text-ink-muted text-[11.5px] tracking-[0.3px]">{note}</span>}
        </span>
      )
    ))}
    {status && (
      <span class="font-mono text-accent inline-flex items-center gap-[6px] text-[11px] tracking-[0.6px] uppercase py-2 ml-[2px]">
        <span class="w-[6px] h-[6px] rounded-[3px] bg-accent flex-shrink-0" />
        {status}
      </span>
    )}
  </div>
</div>
