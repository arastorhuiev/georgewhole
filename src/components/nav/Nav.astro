---
import LocaleSwitcher from '@components/common/LocaleSwitcher.astro';

interface NavItem {
  key: string;
  label: string;
  href: string;
}

interface LocaleOption {
  code: string;
  name: string;
  href?: string;
}

interface Props {
  brand: string;
  brandHref?: string;
  brandTagline?: string;
  items: NavItem[];
  active?: string;
  locale: string;
  locales?: LocaleOption[];
  wide?: boolean;
}

const {
  brand,
  brandHref = '/',
  brandTagline,
  items,
  active,
  locale,
  locales,
  wide = true,
} = Astro.props;
---

<header class="site-header" style={wide ? 'padding:20px 64px;' : 'padding:18px 32px;'}>
  <div class="brand-group">
    <a href={brandHref} class="brandlink brand-name">{brand}</a>
    {brandTagline && (
      <span class="brand-tagline">{brandTagline}</span>
    )}
  </div>
  <nav class="nav-group" aria-label="Main navigation">
    {items.map((item) => (
      <a
        href={item.href}
        class:list={['navlink', 'nav-item']}
        style={item.key === active
          ? 'color:var(--color-accent);border-bottom-color:var(--color-accent);'
          : undefined}
        aria-current={item.key === active ? 'page' : undefined}
      >
        {item.label}
      </a>
    ))}
    <LocaleSwitcher current={locale} locales={locales} />
  </nav>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-hair);
    background: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-sans);
  }

  .brand-group {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .brand-name {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 400;
    letter-spacing: -0.3px;
    color: var(--color-ink);
    text-decoration: none;
    line-height: 1;
  }

  .brand-tagline {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-ink-muted);
    letter-spacing: 0.6px;
    text-transform: uppercase;
  }

  .nav-group {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav-item {
    font-size: 14px;
    color: var(--color-ink);
    text-decoration: none;
    font-weight: 500;
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
  }
</style>
