---
import Kicker from '@components/common/Kicker.astro';

interface Props {
  label?: string;
  items: string[];
}

const {
  label = 'Sources & further reading',
  items,
} = Astro.props;
---

<section class="mt-[40px] py-[24px] border-t border-[var(--color-hair)] font-sans text-ink-soft">
  <Kicker color="var(--color-ink-muted)">{label}</Kicker>
  <ol class="mt-[14px] pl-[18px] text-[13.5px] leading-[1.7]">
    {items.map((item) => (
      <li set:html={item} />
    ))}
  </ol>
</section>
