---
import AuthorPortrait from '@components/common/AuthorPortrait.astro';

interface Props {
  name: string;
  layout?: 'inline' | 'stack';
  blurb?: string;
  date?: string;
  readtime?: string;
}

const {
  name,
  layout = 'inline',
  blurb,
  date,
  readtime,
} = Astro.props;
---

<div class:list={['flex items-center font-sans', layout === 'stack' ? 'gap-[14px]' : 'gap-[12px]']}>
  <AuthorPortrait size={layout === 'stack' ? 48 : 36} />
  <div class:list={[layout === 'stack' ? 'flex flex-col gap-[2px]' : 'text-[13px] text-ink-soft leading-[1.45]']}>
    <div class:list={[layout === 'inline' ? 'text-[13px] font-semibold text-ink inline' : 'text-[14px] font-semibold text-ink']}>{name}</div>
    {blurb && <div class="text-[13px] text-ink-soft leading-[1.4]">{blurb}</div>}
    {(date || readtime) && (
      <div class="font-mono text-[11px] text-ink-muted tracking-[0.5px] mt-[4px] flex items-center gap-[6px]">
        {date && <span>{date}</span>}
        {date && readtime && <span class="opacity-50">·</span>}
        {readtime && <span>{readtime}</span>}
      </div>
    )}
  </div>
</div>
