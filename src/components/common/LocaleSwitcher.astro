---
import Icon from '@components/common/Icon.astro';

interface LocaleOption {
  code: string;
  name: string;
  href?: string;
}

interface Props {
  current: string;
  locales?: LocaleOption[];
  class?: string;
}

const {
  current: currentRaw,
  locales = [
    { code: 'EN', name: 'English' },
    { code: 'UK', name: 'Українська' },
    { code: 'RU', name: 'Русский' },
    { code: 'ES', name: 'Español' },
  ],
  class: className,
} = Astro.props;
const current = currentRaw.toUpperCase();
---

<div
  class:list={['inline-flex items-center gap-[8px] px-[10px] py-[6px] text-[11px] tracking-[0.6px] border border-hair rounded-pill font-mono text-ink-soft', className]}
>
  <Icon name="globe" size={11} />
  {locales.map((locale, i) => (
    <>
      {i > 0 && <span class="opacity-35">·</span>}
      {locale.href ? (
        <a
          href={locale.href}
          class:list={[
            'cursor-pointer transition-colors hover:text-accent',
            locale.code === current ? 'text-accent font-bold' : 'text-ink-soft font-normal',
          ]}
        >
          {locale.code}
        </a>
      ) : (
        <span
          class:list={[
            'cursor-pointer transition-colors hover:text-accent',
            locale.code === current ? 'text-accent font-bold' : 'text-ink-soft font-normal',
          ]}
        >
          {locale.code}
        </span>
      )}
    </>
  ))}
</div>
