---
interface Props {
  size?: number;
  initials?: string;
  class?: string;
}

const {
  size = 56,
  initials = 'gw',
  class: className,
} = Astro.props;

const fontSize = size * 0.42;
---

<div
  class={className}
  style={`width:${size}px;height:${size}px;border-radius:50%;flex-shrink:0;background:linear-gradient(135deg,#D9CFB6 0%,#A89A7E 100%);display:flex;align-items:center;justify-content:center;color:rgba(42,39,35,0.55);font-family:var(--font-serif);font-size:${fontSize}px;letter-spacing:0.5px;font-style:italic;border:1px solid var(--color-hair);`}
>
  {initials}
</div>
