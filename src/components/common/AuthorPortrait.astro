---
interface Props {
  size?: number;
  initials?: string;
  class?: string;
}

const {
  size = 56,
  initials = 'gw',
  class: className,
} = Astro.props;

const fontSize = size * 0.42;
// Only the dynamic dimensions stay inline; everything visual is in scoped CSS.
// (Visibility/layout utilities must be applied to a WRAPPER, never here — an
// inline `display` would override a Tailwind `hidden`. See HomeAuthorStripe.)
---

<div
  class:list={['author-portrait', className]}
  style={`width:${size}px;height:${size}px;font-size:${fontSize}px;`}
>
  {initials}
</div>

<style>
  .author-portrait {
    flex-shrink: 0;
    border-radius: 50%;
    background: linear-gradient(135deg, #d9cfb6 0%, #a89a7e 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(42, 39, 35, 0.55);
    font-family: var(--font-serif);
    letter-spacing: 0.5px;
    font-style: italic;
    border: 1px solid var(--color-hair);
  }
</style>
