---
// Inline SVG icon set, ported 1:1 from docs/design/project/components.jsx
// (Icon.*) + blocks-ru.jsx (Check, ExtArrow). Default sizes match the originals;
// override with `size`. Colour follows `currentColor`. Decorative by default
// (aria-hidden) — pass a `label` to expose it to assistive tech.
interface Props {
  name:
    | 'arrow'
    | 'globe'
    | 'chev'
    | 'quote'
    | 'envelope'
    | 'heart'
    | 'hamburger'
    | 'check'
    | 'extArrow';
  size?: number;
  label?: string;
  class?: string;
}

const DEFAULTS: Record<Props['name'], number> = {
  arrow: 14,
  globe: 14,
  chev: 10,
  quote: 28,
  envelope: 14,
  heart: 14,
  hamburger: 18,
  check: 12,
  extArrow: 11,
};

const { name, size, label, class: className } = Astro.props;
const s = size ?? DEFAULTS[name];
const a11y = label
  ? ({ role: 'img', 'aria-label': label } as const)
  : ({ 'aria-hidden': 'true' } as const);
---

{name === 'arrow' && (
  <svg width={s} height={s} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" class={className} {...a11y}><path d="M3 8h10M9 4l4 4-4 4" /></svg>
)}
{name === 'globe' && (
  <svg width={s} height={s} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" class={className} {...a11y}><circle cx="8" cy="8" r="6" /><path d="M2 8h12M8 2c2 2 2 10 0 12M8 2c-2 2-2 10 0 12" /></svg>
)}
{name === 'chev' && (
  <svg width={s} height={s} viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className} {...a11y}><path d="M2 4l3 3 3-3" /></svg>
)}
{name === 'quote' && (
  <svg width={s} height={s} viewBox="0 0 28 28" fill="currentColor" class={className} {...a11y}><path d="M4 18c0-5 3-9 8-10v3c-3 1-5 3-5 6h3v6H4v-5zm12 0c0-5 3-9 8-10v3c-3 1-5 3-5 6h3v6h-6v-5z" opacity=".4" /></svg>
)}
{name === 'envelope' && (
  <svg width={s} height={s} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" class={className} {...a11y}><rect x="2" y="3.5" width="12" height="9" rx="1" /><path d="M2 4l6 4 6-4" /></svg>
)}
{name === 'heart' && (
  <svg width={s} height={s} viewBox="0 0 16 16" fill="currentColor" class={className} {...a11y}><path d="M8 13.5s-5-3.2-5-7.1c0-1.9 1.5-3.4 3.3-3.4 1 0 1.9.5 2.4 1.3.5-.8 1.4-1.3 2.4-1.3 1.8 0 3.3 1.5 3.3 3.4 0 3.9-5 7.1-5 7.1H8z" /></svg>
)}
{name === 'hamburger' && (
  <svg width={s} height={s} viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" class={className} {...a11y}><path d="M3 5h12M3 9h12M3 13h12" /></svg>
)}
{name === 'check' && (
  <svg width={s} height={s} viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class={className} {...a11y}><path d="M3 7.5l2.5 2.5L11 4" /></svg>
)}
{name === 'extArrow' && (
  <svg width={s} height={s} viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" class={className} {...a11y}><path d="M4 8l4-4M4.5 4H8v3.5" /></svg>
)}
