<!-- CrisisResources: provisional per-locale support block; treatment may be reworked later (see BUILD_PLAN §14.2). EN data e.g. National Alliance for Eating Disorders +1-866-662-1235 (NOT the closed NEDA helpline). -->
---
interface Resource {
  name: string;
  contact: string;
  href?: string;
}

interface Props {
  label?: string;
  resources: Resource[];
  note?: string;
  class?: string;
}

const {
  label,
  resources,
  note,
  class: className,
} = Astro.props;
---

<div class:list={['bg-crisis-bg border border-crisis-border rounded-md px-[24px] py-[20px]', className]}>
  {label && (
    <div class="font-mono text-[10px] text-ink-muted tracking-[1.4px] uppercase mb-[12px]">{label}</div>
  )}
  <ul class="list-none m-0 p-0" role="list">
    {resources.map((r, i) => (
      <li class:list={['py-[10px]', i > 0 && 'border-t border-crisis-border']}>
        {r.href ? (
          <a href={r.href} class="flex items-baseline justify-between gap-[12px] no-underline flex-wrap text-ink font-sans hover:text-accent" rel="noopener noreferrer">
            <span class="text-[14px] font-medium leading-[1.4]">{r.name}</span>
            <span class="font-mono text-[13px] tracking-[0.2px] text-ink-soft">{r.contact}</span>
          </a>
        ) : (
          <span class="flex items-baseline justify-between gap-[12px] flex-wrap font-sans">
            <span class="text-[14px] font-medium leading-[1.4] text-ink">{r.name}</span>
            <span class="font-mono text-[13px] tracking-[0.2px] text-ink-soft">{r.contact}</span>
          </span>
        )}
      </li>
    ))}
  </ul>
  {note && (
    <p class="mt-[14px] mb-0 text-[11.5px] leading-[1.5] text-ink-muted font-sans">{note}</p>
  )}
</div>
