---
// OldNewCompare.astro — symmetric "ledger" comparison with central numbered spine.
// Ported pixel-perfect from docs/design/project/blocks-ru.jsx → OldNewCompareRU.
// Desktop: 1fr | 64px spine | 1fr mirrored with numbered nodes.
// Mobile: stacked cards per pair.

import Icon from '@components/common/Icon.astro';

interface Props {
  pairs: Array<[string, string]>;
  layout?: 'desktop' | 'mobile';
  labels: {
    oldHead: string;
    newHead: string;
    oldLabel?: string;
    newLabel?: string;
  };
}

const { pairs, layout = 'desktop', labels } = Astro.props;
---

{layout === 'mobile' ? (
  <div class="flex flex-col gap-[14px]">
    {pairs.map(([oldR, newR], i) => (
      <div
        class="bg-surface-soft border border-hair relative px-[18px] pt-[18px] pb-[16px]"
      >
        <div
          class="font-mono text-ink-muted absolute top-[14px] right-[14px] text-[11px] tracking-[0.6px]"
        >
          0{i + 1}
        </div>
        <div
          class="font-mono text-ink-muted text-[9.5px] tracking-[1.4px] uppercase mb-[6px]"
        >
          {labels.oldLabel ?? labels.oldHead}
        </div>
        <div
          class="font-serif text-ink-muted text-[17px] leading-[1.4] line-through decoration-[rgba(140,132,120,0.5)] decoration-[1px]"
        >
          {oldR}
        </div>
        <div class="h-[1px] bg-hair my-[14px] mb-[12px]" />
        <div
          class="font-mono text-accent text-[9.5px] tracking-[1.4px] uppercase mb-[6px] flex items-center gap-[6px]"
        >
          <Icon name="check" size={12} />
          {labels.newLabel ?? labels.newHead}
        </div>
        <div class="font-serif text-ink text-[18px] leading-[1.4]">
          {newR}
        </div>
      </div>
    ))}
  </div>
) : (
  <div class="oldnew font-serif">
    {/* column headers */}
    <div class="grid grid-cols-[1fr_64px_1fr] items-end mb-[4px]">
      <div
        class="font-mono text-ink-muted text-right text-[11px] tracking-[1.4px] uppercase pb-[14px]"
      >
        {labels.oldHead}
      </div>
      <div />
      <div
        class="font-mono text-accent text-left text-[11px] tracking-[1.4px] uppercase pb-[14px]"
      >
        {labels.newHead}
      </div>
    </div>

    {pairs.map(([oldR, newR], i) => (
      <div class="grid grid-cols-[1fr_64px_1fr] items-stretch">
        {/* old — right-aligned, muted, struck */}
        <div
          class="text-ink-muted text-right py-[22px] border-t border-hair text-[19px] leading-[1.4] line-through decoration-[rgba(140,132,120,0.45)] decoration-[1px] flex items-center justify-end"
        >
          {oldR}
        </div>

        {/* spine node */}
        <div class="relative border-t border-hair">
          <div
            class="absolute left-1/2 top-0 bottom-0 w-[1px] bg-hair -translate-x-[0.5px]"
          />
          <div
            class="font-mono text-accent bg-bg absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[32px] h-[32px] rounded-[16px] border border-[var(--color-accent-hair)] flex items-center justify-center text-[12px] tracking-[0.4px]"
          >
            0{i + 1}
          </div>
        </div>

        {/* new — left-aligned, ink */}
        <div
          class="text-ink text-left py-[22px] border-t border-hair text-[19px] leading-[1.4] flex items-center"
        >
          {newR}
        </div>
      </div>
    ))}
  </div>
)}
