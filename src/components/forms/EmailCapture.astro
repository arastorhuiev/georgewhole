---
import Icon from '@components/common/Icon.astro';
import Kicker from '@components/common/Kicker.astro';

interface Props {
  variant?: 'newsletter' | 'quiz';
  compact?: boolean;
  bare?: boolean;
  sent?: boolean;
  action?: string;
  strings: {
    kicker?: string;
    title: string;
    sub?: string;
    placeholder: string;
    submit: string;
    note?: string;
    sentTitle: string;
    sentBody: string;
  };
}

const {
  variant = 'newsletter',
  compact = false,
  bare = false,
  sent = false,
  action,
  strings,
} = Astro.props;

const isQuiz = variant === 'quiz';
---

{sent ? (
  <div class="font-sans">
    <div class="inline-flex items-center justify-center w-[38px] h-[38px] rounded-[19px] bg-[rgba(63,107,94,0.1)] text-accent mb-[16px]">
      <Icon name="check" size={18} />
    </div>
    <h3
      class:list={['font-serif text-ink font-normal leading-[1.2] tracking-[-0.3px] mt-0 mb-[8px]', compact ? 'text-[22px]' : 'text-[26px]']}
    >
      {strings.sentTitle}
    </h3>
    <p class="text-ink-soft text-[14.5px] leading-[1.6] m-0">{strings.sentBody}</p>
  </div>
) : (
  <div class="font-sans">
    {isQuiz && strings.kicker && (
      <Kicker>{strings.kicker}</Kicker>
    )}
    {!bare && (
      <h3
        class:list={[
          'font-serif text-ink font-normal leading-[1.2] tracking-[-0.3px]',
          isQuiz
            ? compact ? 'text-[26px] mt-[12px] mb-[10px]' : 'text-[32px] mt-[12px] mb-[10px]'
            : compact ? 'text-[22px] mt-0 mb-[8px]' : 'text-[26px] mt-0 mb-[8px]',
        ]}
      >
        {strings.title}
      </h3>
    )}
    {!bare && strings.sub && (
      <p class="text-ink-soft text-[14.5px] leading-[1.6] mt-0 mb-[18px] max-w-[480px]">{strings.sub}</p>
    )}
    <form method="post" action={action ?? '#'} class="flex gap-[8px] flex-wrap max-w-[460px]">
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="absolute left-[-9999px] w-px h-px overflow-hidden opacity-0 pointer-events-none" aria-hidden="true" />
      <input
        type="email"
        name="email"
        placeholder={strings.placeholder}
        required
        class="flex-[1_1_220px] px-[14px] py-[12px] text-[14px] font-sans border border-hair bg-bg text-ink rounded-md outline-none"
      />
      <button
        type="submit"
        class="px-[18px] py-[12px] text-[14px] font-medium font-sans bg-accent text-accent-fg rounded-md border-none cursor-pointer disabled:cursor-default enabled:hover:bg-accent-deep enabled:hover:-translate-y-px enabled:hover:shadow-[0_5px_14px_rgba(47,82,70,0.22)] enabled:active:translate-y-0 enabled:active:shadow-[0_2px_6px_rgba(47,82,70,0.2)]"
      >
        {strings.submit}
      </button>
    </form>
    {strings.note && (
      <p class="text-ink-muted text-[11.5px] mt-[12px] mb-0">{strings.note}</p>
    )}
  </div>
)}
