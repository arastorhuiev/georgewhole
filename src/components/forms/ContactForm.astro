---
import Icon from '@components/common/Icon.astro';

interface Props {
  layout?: 'desktop' | 'mobile';
  sent?: boolean;
  action?: string;
  strings: {
    topicsLabel: string;
    topics: string[];
    nameLabel: string;
    namePh: string;
    emailLabel: string;
    emailPh: string;
    msgLabel: string;
    msgPh: string;
    submit: string;
    fine: string;
    sentTitle: string;
    sentBody: string;
    sentAgain: string;
    elsewhereLabel: string;
  };
  elsewhere?: Array<[string, string]>;
}

const {
  layout = 'desktop',
  sent = false,
  action,
  strings,
  elsewhere = [],
} = Astro.props;

const wide = layout === 'desktop';
---

<div class:list={['font-sans grid items-start', wide ? 'grid-cols-[1.2fr_1fr] gap-[64px]' : 'grid-cols-1 gap-[32px]']}>

  {/* ── Form col / success state ── */}
  {sent ? (
    <div class:list={[wide && 'py-[8px]']}>
      <div class="inline-flex items-center justify-center w-[40px] h-[40px] rounded-[20px] bg-[rgba(63,107,94,0.1)] text-accent mb-[18px]">
        <Icon name="check" size={19} />
      </div>
      <h3
        class:list={['font-serif text-ink font-normal leading-[1.2] tracking-[-0.4px] mt-0 mb-[10px]', wide ? 'text-[30px]' : 'text-[24px]']}
      >
        {strings.sentTitle}
      </h3>
      <p class="text-ink-soft text-[15px] leading-[1.6] mt-0 mb-[24px] max-w-[420px]">{strings.sentBody}</p>
      {/* sentAgain is a static anchor back to form — backend wires the real reset */}
      <button
        type="button"
        class="inline-flex items-center gap-[8px] px-[18px] py-[11px] bg-transparent border border-hair rounded-pill font-sans text-[13.5px] font-medium text-ink cursor-pointer disabled:cursor-default enabled:hover:border-accent enabled:hover:bg-[rgba(63,107,94,0.07)] enabled:hover:text-accent-deep enabled:active:bg-[rgba(63,107,94,0.12)]"
      >
        {strings.sentAgain}
      </button>
    </div>
  ) : (
    <form method="post" action={action ?? '#'} class="flex flex-col">
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="absolute left-[-9999px] w-px h-px overflow-hidden opacity-0 pointer-events-none" aria-hidden="true" />

      {/* Topic chips */}
      <div class="mb-[22px]">
        <span class="block font-mono text-ink-muted text-[10.5px] tracking-[1.2px] uppercase mb-[8px]">{strings.topicsLabel}</span>
        <div class="flex gap-[8px] flex-wrap">
          {strings.topics.map((topic, i) => (
            <button
              type="button"
              name="topic"
              value={topic}
              class:list={[
                'px-[16px] py-[9px] rounded-pill border font-sans text-[13.5px] font-medium cursor-pointer hover:border-accent',
                i === 0
                  ? 'bg-accent text-accent-fg border-accent'
                  : 'bg-transparent text-ink-soft border-hair',
              ]}
            >
              {topic}
            </button>
          ))}
        </div>
      </div>

      {/* Name + Email row */}
      <div class:list={['grid gap-[16px] mb-[16px]', wide ? 'grid-cols-2' : 'grid-cols-1']}>
        <label class="block">
          <span class="block font-mono text-ink-muted text-[10.5px] tracking-[1.2px] uppercase mb-[8px]">{strings.nameLabel}</span>
          <input
            type="text"
            name="name"
            placeholder={strings.namePh}
            class="w-full box-border px-[14px] py-[12px] text-[14.5px] font-sans border border-hair bg-bg text-ink rounded-md outline-none transition-[border-color,box-shadow] duration-[0.16s] ease focus:border-accent focus:shadow-[0_0_0_3px_rgba(63,107,94,0.1)]"
          />
        </label>
        <label class="block">
          <span class="block font-mono text-ink-muted text-[10.5px] tracking-[1.2px] uppercase mb-[8px]">{strings.emailLabel}</span>
          <input
            type="email"
            name="email"
            placeholder={strings.emailPh}
            required
            class="w-full box-border px-[14px] py-[12px] text-[14.5px] font-sans border border-hair bg-bg text-ink rounded-md outline-none transition-[border-color,box-shadow] duration-[0.16s] ease focus:border-accent focus:shadow-[0_0_0_3px_rgba(63,107,94,0.1)]"
          />
        </label>
      </div>

      {/* Message */}
      <label class="block mb-[18px]">
        <span class="block font-mono text-ink-muted text-[10.5px] tracking-[1.2px] uppercase mb-[8px]">{strings.msgLabel}</span>
        <textarea
          name="message"
          placeholder={strings.msgPh}
          rows={5}
          class="w-full box-border px-[14px] py-[12px] text-[14.5px] font-sans border border-hair bg-bg text-ink rounded-md outline-none resize-y leading-[1.6] transition-[border-color,box-shadow] duration-[0.16s] ease focus:border-accent focus:shadow-[0_0_0_3px_rgba(63,107,94,0.1)]"
        ></textarea>
      </label>

      {/* Submit row */}
      <div class="flex items-center gap-[16px] flex-wrap">
        <button
          type="submit"
          class="inline-flex items-center gap-[10px] px-[22px] py-[13px] text-[14.5px] font-medium font-sans bg-accent text-accent-fg rounded-pill border-none cursor-pointer disabled:cursor-default enabled:hover:bg-accent-deep enabled:hover:-translate-y-px enabled:hover:shadow-[0_5px_14px_rgba(47,82,70,0.22)] enabled:active:translate-y-0 enabled:active:shadow-[0_2px_6px_rgba(47,82,70,0.2)]"
        >
          {strings.submit}
          <Icon name="arrow" size={13} />
        </button>
        <span class="text-ink-muted font-sans text-[12px] max-w-[260px] leading-[1.5]">{strings.fine}</span>
      </div>
    </form>
  )}

  {/* ── Aside: elsewhere ── */}
  <aside class="flex flex-col gap-0">
    <div class="font-mono text-ink-muted text-[10.5px] tracking-[1.4px] uppercase mb-[6px]">{strings.elsewhereLabel}</div>
    {elsewhere.map(([name, note]) => (
      <a class="flex items-baseline justify-between gap-[12px] px-0 py-[13px] border-t border-hair-soft text-ink no-underline" href="#">
        <span class="font-serif text-[16px]">{name}</span>
        <span class="text-ink-muted font-sans text-[12px] text-right">{note}</span>
      </a>
    ))}
  </aside>

</div>
